<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (dataExtractionRules). Wie backup_rules.xml: der Verlauf mit Transkripten und
    Audiokopien bleibt lokal - weder im Cloud-Backup noch beim Geraetewechsel.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="history" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="history" />
    </device-transfer>
</data-extraction-rules>
